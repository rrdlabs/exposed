# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template documents the required variables, so it belongs in the repo.
!.env.example

# local database. The SQLite file is the live customer data and its WAL/SHM
# sidecars; none of it belongs in a public repository.
/data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
