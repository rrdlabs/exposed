# Exposed — environment configuration
#
# Copy to .env.local for local dev, or manage these as real environment
# variables in PM2. Never commit a filled-in copy of this file.

# ---------------------------------------------------------------- required ---

# Signs session cookies. Generate with: openssl rand -base64 48
# Rotating this logs everyone out.
SESSION_SECRET=

# Grants access to /admin. Generate with: openssl rand -base64 32
# Anyone with this value can approve charity claims, so treat it as a password.
ADMIN_TOKEN=

# ---------------------------------------------------------------- optional ---

# Where the SQLite/libsql database file lives. Defaults to ./data/exposed.db
# DATABASE_PATH=./data/exposed.db

# Absolute origin, used for canonical URLs, Stripe's return_url and in emails.
# No trailing slash.
# SITE_URL=https://rrdlabs.online/exposed

# ----------------------------------------------------------------- billing ---

# Stripe secret key. Dashboard -> Developers -> API keys. Starts sk_test_ in
# test mode, sk_live_ in live mode.
STRIPE_SECRET_KEY=

# Publishable key, safe to expose to the browser. Must be the pk_ that pairs
# with the secret key above; a mismatched pair fails at mount time with an
# error that is genuinely hard to read.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Signs the Stripe webhook signature check. Dashboard -> Developers -> Webhooks
# -> your endpoint -> Signing secret. Starts whsec_.
#
# Unset locally is fine. In production a missing value means the endpoint
# returns 503 and no subscription is ever granted, so set it before going live.
STRIPE_WEBHOOK_SECRET=

# Recurring Price IDs. Dashboard -> Products -> your product -> Pricing ->
# copy the price_ id. These are monthly recurring prices; the checkout session
# is created with mode: 'subscription', so a one-off price will not work.
STRIPE_SOLO_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# ----------------------------------------------------------------- alerting ---

# Without this, scans still run and findings still record; only the emails are
# skipped and logged. From resend.com after verifying your sending domain.
RESEND_API_KEY=

# Any sender on a domain you have verified with Resend.
MAIL_FROM="Exposed <alerts@rrdlabs.online>"

# --------------------------------------------------------------------- tax ---
#
# NOT WIRED UP ON PURPOSE. Lemon Squeezy was the merchant of record and
# remitted VAT/sales tax on every sale. Stripe is not, so that liability now
# sits with us.
#
# The fix is Stripe Tax: set it up under Dashboard -> Settings -> Tax, then
# add automatic_tax: { enabled: true } to the session in
# src/lib/billing/stripe.ts. Enabling it before Tax is configured makes every
# session creation fail, which is why it is not enabled by default.
